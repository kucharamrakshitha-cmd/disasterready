# Copy this file to .env and fill in your own values. Never commit .env.

# Lyzr Agent Studio (https://studio.lyzr.ai)
LYZR_API_KEY=your_lyzr_api_key
TRIAGE_AGENT_ID=your_triage_agent_id
PLANNER_AGENT_ID=your_resource_planner_agent_id
SOS_AGENT_ID=your_sos_drafter_agent_id
MANAGER_AGENT_ID=your_manager_agent_id
ALLOCATOR_AGENT_ID=your_rescuer_allocation_agent_id

# Qdrant Cloud (https://cloud.qdrant.io)
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Telegram bot for responder alerts
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Login sessions and the control-room account
SECRET_KEY=any_long_random_text
OPERATOR_EMAIL=control@disasterready.demo
OPERATOR_PASSWORD=ready2026